{
  "name": "cinelume-engine",
  "version": "2.0.0",
  "description": "Deterministic cinematic story-video renderer: storyboard JSON -> MP4",
  "type": "module",
  "main": "render.mjs",
  "bin": {
    "cinelume-render": "render.mjs"
  },
  "scripts": {
    "render": "node render.mjs",
    "validate": "node validate.mjs",
    "demo": "node render.mjs ../examples/silicon-island.json --preview",
    "install-browser": "npx playwright install chromium",
    "voices": "node tts.mjs --list"
  },
  "dependencies": {
    "playwright-core": "^1.48.0",
    "msedge-tts": "^2.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
