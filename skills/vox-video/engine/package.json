{
  "name": "vox-video-engine",
  "version": "1.0.0",
  "description": "Deterministic Vox-style motion-graphics renderer: storyboard JSON -> MP4",
  "type": "module",
  "main": "render.mjs",
  "bin": { "vox-render": "render.mjs" },
  "scripts": {
    "render": "node render.mjs",
    "validate": "node validate.mjs",
    "demo": "node render.mjs ../examples/ai-chip-war.json --preview",
    "install-browser": "npx playwright install chromium"
  },
  "dependencies": { "playwright-core": "^1.48.0" },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
